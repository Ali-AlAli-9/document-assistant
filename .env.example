# ---------- Django ----------
DEBUG=True
SECRET_KEY=change-me-to-a-random-secret-key
ALLOWED_HOSTS='["localhost","127.0.0.1"]'
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# ---------- Database ----------
# sqlite  -> يستخدم SQLite (للتطوير)
# أي اسم آخر -> يستخدم PostgreSQL (للإنتاج)
DB_NAME=sqlite
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---------- Vector Store ----------
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=documents

# ---------- Embeddings ----------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_MODEL_DIR=models

# ---------- Chunking ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=10
RETRIEVAL_SCORE_THRESHOLD=0.1

# ---------- LLM Provider ----------
# اختر: ollama | gemini
LLM_PROVIDER=ollama

# Ollama (محلي، مجاني)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Gemini (سحابي، مجاني حتى 1500 req/day — ملاحظة: محجوب في بعض المناطق)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- LLM Settings ----------
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---------- Conversation ----------
CONVERSATION_HISTORY_LENGTH=6
LLM_MAX_CONTEXT_CHARS=4000

# ---------- Upload ----------
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS='[".pdf",".txt",".docx"]'

# ---------- Logging ----------
LOG_LEVEL=INFO
