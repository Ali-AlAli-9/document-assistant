# ---------- Django ----------
DEBUG=True
SECRET_KEY=change-me-to-a-random-secret-key
ALLOWED_HOSTS='["localhost","127.0.0.1"]'
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# ---------- Database ----------
# sqlite  -> يستخدم SQLite (للتطوير)
# أي اسم آخر -> يستخدم PostgreSQL (للإنتاج)
DB_NAME=sqlite
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---------- Vector Store ----------
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=documents

# ---------- Embeddings ----------
# النموذج المحلي الوحيد: multilingual-e5-small — مجاني بالكامل بلا أيّ حصص
# يومية، ويعالج العربية بجودة تقارب Gemini (قياسنا على مستند العرض:
# Hits@5 = 8/9 مقابل ~8/9 لـ Gemini). استُبدل به all-MiniLM-L6-v2 لأن مفرداته
# إنجليزية فقط فيفتّك العربية حرفًا حرفًا ويصيّر الاسترجاع ضجيجًا.
# تغيير النموذج يستلزم إعادة ingest: المجموعتان متساويتا الأبعاد (384) لكن
# متجهات نموذجين مختلفين لا تُقارن ببعضها — أفرغ المجموعة أولاً (reset_demo).
# الخيارات:
#   'local'  -> نموذج sentence-transformers من EMBEDDING_MODEL_DIR (أو ذاكرة
#               HuggingFace المؤقتة). افتراضي ومجاني بلا حصص.
#   'gemini' -> Google AI Studio embedContent؛ EMBEDDING_MODEL يحمل اسم نموذج
#               Gemini وGEMINI_API_KEY مطلوبة. جودة عربية ممتازة لكنه يستهلك
#               الحصة اليومية المجانية (مخاطرة 429). انظر
#               infrastructure/embedding/gemini_embedding_adapter.py.
EMBEDDING_PROVIDER=local
# الاسم الكامل لمستودع HuggingFace. يُشتقّ منه اسم المجلد المحلي (آخر جزء بعد /)
# تلقائيًّا — راجع resolve_local_model_path.
# عند EMBEDDING_PROVIDER=gemini يكون هذا هو اسم النموذج، مثل gemini-embedding-001.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_MODEL_DIR=models
# أبعاد التضمين عند مزوّد gemini فقط (1..3072؛ 768 كافٍ ويُبقي الفهرس صغيرًا).
# النماذج المحلية تحدّد أبعادها تلقائيًّا (e5-small = 384).
EMBEDDING_DIMENSION=768

# ---------- Chunking ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ---------- Retrieval ----------
# مرشّحات لكل مستند. رُفعت إلى 20 حتى تصل الأسئلة الشاملة
# (مثل: "ابحث في كل الفصول عن الصعوبات والتحديات") إلى أجزاء أعمق من المستند.
RETRIEVAL_TOP_K=20
RETRIEVAL_SCORE_THRESHOLD=0.1
# توسعة الأقسام: كم قطعة تلي رأس القسم (مثل "4-4-1 ...") تُسترجَع تلقائيًّا
# ليدخل جسم القسم إلى سياق الإجابة. صفّرها لتعطيل التوسعة.
RETRIEVAL_SECTION_EXPAND=3
# سقف إجمالي لعدد القطع المقدَّمة للنموذج بعد إزالة التكرار.
RETRIEVAL_MAX_CONTEXT_CHUNKS=50

# ---------- LLM Provider ----------
# اختر: ollama | gemini
LLM_PROVIDER=ollama

# Ollama (محلي، مجاني)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Gemini (سحابي، مجاني حتى 1500 req/day — ملاحظة: محجوب في بعض المناطق)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---------- LLM Settings ----------
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ---------- Conversation ----------
CONVERSATION_HISTORY_LENGTH=6
LLM_MAX_CONTEXT_CHARS=4000
# تُحذف المحادثات تلقائياً بعد هذا القدر من الخمول (بالدقائق)
CONVERSATION_TTL_MINUTES=30
# الحد الأقصى للمحادثات النشطة لكل جلسة
CONVERSATIONS_MAX_PER_SESSION=10
# طول مقتطف المصدر المعروض في الواجهة (الأحرف)
SOURCE_SNIPPET_MAX_CHARS=350

# ---------- Upload ----------
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS='[".pdf",".txt",".docx"]'

# ---------- Logging ----------
LOG_LEVEL=INFO

# ============================================================================
# Production / hosting (Render, Railway, Fly...) — see DEPLOY.md
# ============================================================================
# Never delete uploads + documents + vector store when the server process exits.
# This is the default, and the value only ever turns it ON: an unset variable
# means "keep my data". The previous default inferred "any server process" as
# "wipe everything", so one Ctrl+C during development destroyed every upload,
# chunk, conversation and session.
#
# To clear the demo deliberately, use the command rather than this variable:
#     manage.py reset_demo [--yes] [--prefix demo-] [--owner-id N]
RAG_CLEANUP_ON_EXIT=0

# Read the real visitor IP from X-Forwarded-For (the host's proxy sets
# REMOTE_ADDR to itself, which would collapse the per-IP rate limits into one
# shared bucket). Set to false only if the app is exposed directly.
TRUST_PROXY_HEADERS=true

